{
  "family": "matching-py",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::009160070658:role/matching-py-execution-role",
  "taskRoleArn": "arn:aws:iam::009160070658:role/matching-py-task-role",
  "containerDefinitions": [
    {
      "name": "matching-py",
      "image": "009160070658.dkr.ecr.us-east-1.amazonaws.com/matching-py:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {"name": "LLM_PROVIDER",            "value": "bedrock"},
        {"name": "BEDROCK_REGION",          "value": "us-east-1"},
        {"name": "BEDROCK_LLM_MODEL_ID",    "value": "us.anthropic.claude-3-5-haiku-20241022-v1:0"},
        {"name": "BEDROCK_EMBED_MODEL_ID",  "value": "amazon.titan-embed-text-v2:0"},
        {"name": "EMBED_DIM",               "value": "256"},
        {"name": "REDIS_STREAM",            "value": "rides.events"},
        {"name": "REDIS_DLQ_STREAM",        "value": "rides.events.dlq"},
        {"name": "REDIS_CONSUMER_GROUP",    "value": "matching-preferences"},
        {"name": "REDIS_CONSUMER_NAME",     "value": "matching-py-1"},
        {"name": "LOG_LEVEL",               "value": "INFO"},
        {"name": "HTTP_PORT",               "value": "8000"},
        {"name": "OSRM_URL",               "value": "http://osrm:5000"},
        {"name": "OSRM_MAX_TABLE_SIZE",    "value": "100"},
        {"name": "CANDIDATE_RADIUS_M",     "value": "1500"},
        {"name": "MAX_CANDIDATES",         "value": "80"},
        {"name": "ROUTE_GEOMETRY_TOP_K",   "value": "3"},
        {"name": "PICKUP_ETA_NORM_S",      "value": "1800"},
        {"name": "SCORE_W_DETOUR",         "value": "0.5"},
        {"name": "SCORE_W_TIME",           "value": "0.3"},
        {"name": "SCORE_W_ETA",            "value": "0.2"},
        {"name": "BBOX_LAT_MIN",           "value": "17.8"},
        {"name": "BBOX_LAT_MAX",           "value": "21.7"},
        {"name": "BBOX_LNG_MIN",           "value": "-92.5"},
        {"name": "BBOX_LNG_MAX",           "value": "-86.7"}
      ],
      "secrets": [
        {"name": "REDIS_URL",     "valueFrom": "arn:aws:ssm:us-east-1:009160070658:parameter/matching-py/REDIS_URL"},
        {"name": "DATABASE_URL",  "valueFrom": "arn:aws:ssm:us-east-1:009160070658:parameter/matching-py/DATABASE_URL"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/matching-py",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=3)\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
