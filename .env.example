# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=rides.events
REDIS_DLQ_STREAM=rides.events.dlq
REDIS_CONSUMER_GROUP=matching-preferences
REDIS_CONSUMER_NAME=matching-py-1

# ── Postgres + pgvector ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ridedb

# ── AWS Bedrock ────────────────────────────────────────────────────────────────
# Región donde se invocan los modelos
BEDROCK_REGION=us-east-1

# Cross-region inference profile para Claude 3.5 Haiku (prefijo us. para US)
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Titan Text Embeddings V2 (disponible en us-east-1)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Dimensión del vector: Titan V2 soporta 256, 512 o 1024
EMBED_DIM=256

# ── Proveedor LLM ──────────────────────────────────────────────────────────────
# Opciones: bedrock | fake
# Usa "fake" para desarrollo local sin credenciales AWS
LLM_PROVIDER=bedrock

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Pool asyncpg compartido por el consumer y el servidor HTTP
DB_POOL_MAX_SIZE=10

# ── HTTP (POST /match, GET /health) ────────────────────────────────────────────
HTTP_PORT=8000

# ── OSRM ───────────────────────────────────────────────────────────────────────
OSRM_URL=http://osrm:5000
# Debe coincidir con --max-table-size del contenedor OSRM
OSRM_MAX_TABLE_SIZE=100
OSRM_CONNECT_TIMEOUT_S=1.0
OSRM_READ_TIMEOUT_S=2.0

# ── Matching ───────────────────────────────────────────────────────────────────
# Radio (m) entre la ruta del ride y pickup/dropoff
CANDIDATE_RADIUS_M=1500
# Máximo de rides evaluados por búsqueda
MAX_CANDIDATES=80
# Primeros K candidatos con routeGeometry
ROUTE_GEOMETRY_TOP_K=3
# Estados de matches que NO cuentan como match activo
MATCH_TERMINAL_STATUSES=rejected,completed,cancelled

# ── Scoring heuristic-v1 ───────────────────────────────────────────────────────
# ETA (s) a partir de la cual el factor ETA aporta 0
PICKUP_ETA_NORM_S=1800
SCORE_W_DETOUR=0.5
SCORE_W_TIME=0.3
SCORE_W_ETA=0.2

# ── Bbox península de Yucatán (fuera → 422) ────────────────────────────────────
BBOX_LAT_MIN=17.8
BBOX_LAT_MAX=21.7
BBOX_LNG_MIN=-92.5
BBOX_LNG_MAX=-86.7
